# Copy to .env for local development (see docs/01-architecture.md)
PORT=4210
CONTEXT_PATH=/edu-sharing
# management server (GET /metrics, GET /health), separate from the app port
MANAGEMENT_PORT=4211
# external tomcat connector (2FA applies) - proxying and node metadata
BACKEND_URL=http://localhost:8100
# internal tomcat connector - config fetches only. Mapped to loopback by the dev
# compose override (1_repository-dev.yml, REPOSITORY_SERVICE_PORT_HTTP_INTERNAL)
BACKEND_INTERNAL_URL=http://localhost:8104
DIST_DIR=../Frontend/dist
DEV=true
LOG_LEVEL=debug
