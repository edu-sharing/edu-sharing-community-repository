<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.edu_sharing</groupId>
    <artifactId>edu_sharing-community-repository-deploy-docker</artifactId>
    <version>git</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>edu_sharing-community-repository-deploy-docker-helm</artifactId>
  <packaging>pom</packaging>

  <name>edu_sharing-community-repository-deploy-docker-helm</name>

  <build>

    <resources>

      <resource>
        <directory>src/main/chart</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>Chart.yaml</exclude>
          <exclude>values.yaml</exclude>
        </excludes>
      </resource>

      <resource>
        <directory>src/main/chart</directory>
        <filtering>true</filtering>
        <includes>
          <include>Chart.yaml</include>
          <include>values.yaml</include>
        </includes>
      </resource>

    </resources>

    <pluginManagement>

      <plugins>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <configuration>
            <outputDirectory>${project.build.directory}/chart</outputDirectory>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <configuration>
            <descriptors>
              <descriptor>src/main/assembly/bin.xml</descriptor>
            </descriptors>
          </configuration>
          <executions>
            <execution>
              <id>assembly</id>
              <goals>
                <goal>single</goal>
              </goals>
              <phase>package</phase>
            </execution>
          </executions>
        </plugin>

        <!-- chart modules only declare the plugin -->
        <plugin>
          <groupId>io.kokuwa.maven</groupId>
          <artifactId>helm-maven-plugin</artifactId>
          <executions>
            <execution>
              <id>init</id>
              <goals>
                <goal>init</goal>
              </goals>
              <phase>initialize</phase>
            </execution>
            <execution>
              <id>dependency-build</id>
              <goals>
                <goal>dependency-build</goal>
              </goals>
              <phase>compile</phase>
            </execution>
            <execution>
              <id>lint</id>
              <goals>
                <goal>lint</goal>
              </goals>
              <phase>test</phase>
            </execution>
            <execution>
              <id>package</id>
              <goals>
                <goal>package</goal>
              </goals>
              <phase>package</phase>
            </execution>
            <execution>
              <id>upload</id>
              <goals>
                <goal>upload</goal>
              </goals>
              <phase>deploy</phase>
            </execution>
          </executions>
        </plugin>

      </plugins>

    </pluginManagement>

  </build>

  <modules>
    <module>frontend-server</module>
    <module>search-solr</module>
    <module>service</module>
    <module>transform-aio</module>
    <module>transform-es</module>
  </modules>

</project>
