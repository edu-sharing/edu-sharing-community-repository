<?xml version="1.0" encoding="UTF-8"?>
<config>
	<values>
		<extension></extension>
		<loginUrl></loginUrl>
		<editProfileUrl></editProfileUrl>
		<branding>true</branding>
		<editProfile>true</editProfile>
		<nodeReport>true</nodeReport>
		<register>
			<local>false</local>
		</register>
		<!--
		<relations>
			<allowedRelations>hasPart</allowedRelations>
			<allowedRelations>isBasisFor</allowedRelations>
			<allowedRelations>references</allowedRelations>
		</relations>
		-->
		<helpMenuOptions>
			<key>ONLINE_HELP</key>
			<icon>help_outline</icon>
			<url>https://docs.edu-sharing.com/de/edu-sharing-documentation/:version/?l=de</url>
		</helpMenuOptions>
		<helpMenuOptions>
			<key>WHATS_NEW</key>
			<icon>lightbulb_outline</icon>
			<url>https://docs.edu-sharing.com/de/edu-sharing-documentation/:version/was-ist-neu-in-edu-sharing</url>
		</helpMenuOptions>
		<frontpage>
			<dashboard>
				<shortcuts>
					<enabled>true</enabled>
					<maxEntries>6</maxEntries>
					<entry>
						<id>search</id>
						<icon>search</icon>
						<url>/edu-sharing/components/search</url>
						<toolpermission/>
						<defaultVisibility>visible</defaultVisibility>
					</entry>
					<entry>
						<id>workspace</id>
						<icon>cloud</icon>
						<url>/edu-sharing/components/workspace</url>
						<toolpermission>TOOLPERMISSION_WORKSPACE</toolpermission>
						<defaultVisibility>visible</defaultVisibility>
					</entry>
					<entry>
						<id>mycollections</id>
						<icon>layers</icon>
						<url>/edu-sharing/components/collections?scope=MY</url>
						<toolpermission/>
						<defaultVisibility>visible</defaultVisibility>
					</entry>
					<entry>
						<id>invitedcollections</id>
						<icon>group</icon>
						<url>/edu-sharing/components/collections?scope=EDU_GROUPS</url>
						<toolpermission/>
						<defaultVisibility>visible</defaultVisibility>
					</entry>
					<entry>
						<id>publiccollections</id>
						<icon>language</icon>
						<url>/edu-sharing/components/collections?scope=EDU_ALL</url>
						<toolpermission/>
						<defaultVisibility>hidden</defaultVisibility>
					</entry>
					<entry>
						<id>aboutme</id>
						<icon>person</icon>
						<url>/edu-sharing/components/profiles/-me-</url>
						<toolpermission/>
						<defaultVisibility>hidden</defaultVisibility>
					</entry>
					<entry>
						<id>documentation</id>
						<icon>book</icon>
						<url>https://docs.edu-sharing.com/de/edu-sharing-documentation</url>
						<toolpermission/>
						<defaultVisibility>hidden</defaultVisibility>
					</entry>
				</shortcuts>
				<!-- Swimlanes shown on the dashboard (in order). If not set, all swimlanes are shown expanded.
				Available ids: featured-media, collections, recent-activities, shares, assignments
				<swimlane>
					<id>collections</id>
					<defaultExpanded>true</defaultExpanded>
				</swimlane>
				<swimlane>
					<id>recent-activities</id>
					<defaultExpanded>false</defaultExpanded>
				</swimlane>
				-->
			</dashboard>
		</frontpage>
	</values>
	<contexts>
	</contexts>
</config>
