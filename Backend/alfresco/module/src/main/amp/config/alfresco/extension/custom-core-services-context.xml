  <!--
      override transform client for getting nodeproperties in transformer app
      currently used implementation is

          org.alfresco.repo.rendition2.LocalSynchronousTransformClient

      cause of properties
          repo.event2.enabled=false
          messaging.subsystem.autoStart=false

      when removing these properties or setting to true the interceptor must be written for

          org.alfresco.repo.rendition2.LocalTransformClient
  -->


  <bean id="localSynchronousTransformClient"
        class="org.edu_sharing.alfresco.transformer.EduLocalSynchronousTransformClient">
    <property name="localTransformServiceRegistry" ref="localTransformServiceRegistry"/>
    <property name="contentService" ref="contentService"/>
    <property name="directAccessUrlEnabled" value="${local.transform.directAccessUrl.enabled}"/>
    <property name="nodeService" ref="nodeService"/>
  </bean>

  <bean id="localTransformClient" class="org.edu_sharing.alfresco.transformer.EduLocalTransformClient"
        init-method="init">
    <property name="localTransformServiceRegistry" ref="localTransformServiceRegistry"/>
    <property name="transactionService" ref="transactionService"/>
    <property name="contentService" ref="contentService"/>
    <property name="renditionService2" ref="renditionService2"/>
    <property name="directAccessUrlEnabled" value="${local.transform.directAccessUrl.enabled}"/>
    <property name="nodeService" ref="nodeService"/>
    <property name="lightbendConfigLoader" ref="lightbendConfigLoader"/>
    <property name="threadPoolSize" value="${local.transform.threadPoolSize}"/>
  </bean>

