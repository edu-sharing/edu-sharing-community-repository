{
  "name": "ngx-edu-sharing-b-api",
  "version": "0.0.6",
  "license": "GNU GPL v2",
  "description": "Angular bindings for Edu-Sharing's B-API",
  "repository": {
    "type": "git",
    "url": "https://github.com/edu-sharing/Edu-Sharing.git",
    "directory": "projects/b-api"
  },
  "homepage": "https://edu-sharing-network.org/",
  "scripts": {
    "check-if-up-to-date": "(test -d src/lib/api)",
    "generate-api:generate-code": "ng-openapi-gen --input build/openapi.json --output src/lib/api",
    "generate-api:prettify-code": "prettier -w 'src/lib/api/**/*.ts' --end-of-line auto",
    "generate-api": "npm run generate-api:generate-code && npm run generate-api:prettify-code",
    "update": "npm i && npm run generate-api",
    "update-if-needed": "npm run check-if-up-to-date || npm run update",
    "fetch-api": "curl -sL https://b-api.staging.openeduhub.net/v3/api-docs/api | jq '.' > build/openapi.json",
    "publish": "npm run update && ng build && cd ../../dist/b-api && npm publish"
  },
  "peerDependencies": {
    "@angular/common": ">=18.0.0",
    "@angular/core": ">=18.0.0",
    "rxjs": ">=7.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "prettier": "^2.4.1",
    "ng-openapi-gen": "^0.51.0"
  }
}
