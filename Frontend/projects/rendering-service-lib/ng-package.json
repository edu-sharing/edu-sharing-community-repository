{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/rendering-service-lib",
  "lib": {
    "entryFile": "src/index.ts",
    "styleIncludePaths": [
      "../edu-sharing-ui/assets/scss"
    ]
  },
  "assets": [
    "assets/**",
    {
      "glob": "**/*",
      "input": "node_modules/ng2-pdfjs-viewer/pdfjs",
      "output": "/assets/pdfjs"
    }
  ]
}
