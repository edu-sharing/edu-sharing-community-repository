{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "..",
    // "chai": required by `storybook/test` (@vitest/expect references the Chai namespace)
    "types": ["node", "jquery", "chai"],
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": false
  },
  "exclude": ["../src/test.ts", "../src/**/*.spec.ts", "../projects/edu-sharing-ui/**/*.spec.ts"],
  "include": [
    "../src/**/*.stories.ts",
    "../projects/edu-sharing-ui/**/*.stories.ts",
    "../src/**/*.d.ts",
    "../src/polyfills.ts",
    "./preview.ts"
  ],
  "files": ["./typings.d.ts"]
}
